                              <ByEntityCondition>
                                 <TriggeringEntities triggeringEntitiesRule="any"><EntityRef entityRef="Ego"/></TriggeringEntities>
                                 <EntityCondition>
                                    <RelativeDistanceCondition entityRef="NPC" freespace="true" relativeDistanceType="euclidianDistance" rule="lessThan" value="$HazardDistance"/>
