      </Init>
      <Story name="LTAPStory">
         <Act name="LTAPAct">
            <ManeuverGroup maximumExecutionCount="1" name="NPCGroup">
               <Actors selectTriggeringEntities="false"><EntityRef entityRef="NPC"/></Actors>
               <Maneuver name="NPCManeuver">
                  <Event name="SyncEvent" priority="override" maximumExecutionCount="1">
                     <Action name="SyncAction">
                        <PrivateAction>
                           <SynchronizeAction masterEntityRef="Ego" targetToleranceMaster="1.0" targetTolerance="1.0">
                              <TargetPositionMaster>
