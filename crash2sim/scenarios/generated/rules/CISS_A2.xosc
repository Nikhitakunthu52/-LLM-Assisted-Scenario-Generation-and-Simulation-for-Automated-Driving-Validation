                                 <SpeedActionTarget><AbsoluteTargetSpeed value="0"/></SpeedActionTarget>
                              </SpeedAction>
                           </LongitudinalAction>
                        </PrivateAction>
                     </Action>
                     <StartTrigger>
                        <ConditionGroup>
