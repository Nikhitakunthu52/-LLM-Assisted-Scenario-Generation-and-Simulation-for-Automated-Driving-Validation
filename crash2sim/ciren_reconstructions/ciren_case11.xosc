      <ManeuverGroup name="ImpactMonitor_mg" maximumExecutionCount="1">
        <Actors selectTriggeringEntities="false"><EntityRef entityRef="V1_Ford_Focus_2014"/></Actors>
        <Maneuver name="ImpactMonitor">
          <!-- Fires (and is logged) when the two bounding boxes touch -->
          <Event name="Impact" priority="parallel">
            <Action name="RecordImpact">
              <GlobalAction><ParameterAction parameterRef="Impacted"><SetAction value="true"/></ParameterAction></GlobalAction>
            </Action>
            <StartTrigger><ConditionGroup>
              <Condition name="V1_hits_V2" delay="0" conditionEdge="rising"><ByEntityCondition>
                <TriggeringEntities triggeringEntitiesRule="any"><EntityRef entityRef="V1_Ford_Focus_2014"/></TriggeringEntities>
                <EntityCondition><CollisionCondition><EntityRef entityRef="V2_Honda_Civic_2010"/></CollisionCondition></EntityCondition>
              </ByEntityCondition></Condition>
            </ConditionGroup></StartTrigger>
          </Event>
        </Maneuver>
      </ManeuverGroup>
        <StartTrigger><ConditionGroup><Condition name="act_start" delay="0" conditionEdge="none"><ByValueCondition><SimulationTimeCondition value="0.000" rule="greaterOrEqual"/></ByValueCondition></Condition></ConditionGroup></StartTrigger>
      </Act>
    </Story>
    <StopTrigger><ConditionGroup><Condition name="end" delay="0" conditionEdge="rising">
      <ByValueCondition><SimulationTimeCondition value="12.500" rule="greaterThan"/></ByValueCondition>
    </Condition></ConditionGroup></StopTrigger>
  </Storyboard>
