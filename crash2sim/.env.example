# Copy to .env (never commit .env)

# esmini: folder containing the esmini and dat2csv executables
ESMINI_BIN=./tools/esmini-demo/bin
# 3D models (cars + road scenes). Auto-detected from <ESMINI_BIN>/../resources/models; override if elsewhere
# ESMINI_MODELS=./tools/esmini-demo/resources/models

# --- Option A: local LLM via Ollama (default, free) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Option B: any OpenAI-compatible API (OpenAI, Groq, Together, HF Inference Endpoint, vLLM) ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
