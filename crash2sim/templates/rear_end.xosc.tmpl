<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by crash2sim from report {{report_id}} - template: rear_end -->
<!-- Ego follows Lead in the same lane. Lead slows/stops; Ego reacts after a reaction time (or not at all). -->
<OpenSCENARIO>
   <FileHeader revMajor="1" revMinor="2" date="{{date}}"
               description="crash2sim rear_end from {{report_id}}" author="crash2sim"/>
   <ParameterDeclarations>
      <ParameterDeclaration name="EgoVehicle"      parameterType="string" value="{{ego_model}}"/>
      <ParameterDeclaration name="LeadVehicle"     parameterType="string" value="{{other_model}}"/>
      <ParameterDeclaration name="EgoSpeed"        parameterType="double" value="{{ego_speed}}"/>
      <ParameterDeclaration name="LeadSpeed"       parameterType="double" value="{{lead_speed}}"/>
      <ParameterDeclaration name="LeadFinalSpeed"  parameterType="double" value="{{lead_final_speed}}"/>
      <ParameterDeclaration name="LeadDecel"       parameterType="double" value="{{lead_decel}}"/>
      <ParameterDeclaration name="LeadBrakeTime"   parameterType="double" value="{{lead_brake_time}}"/>
      <ParameterDeclaration name="EgoStartS"       parameterType="double" value="{{ego_start_s}}"/>
      <ParameterDeclaration name="LeadStartS"      parameterType="double" value="{{lead_start_s}}"/>
      <ParameterDeclaration name="EgoReactionTime" parameterType="double" value="{{reaction_time}}"/>
      <ParameterDeclaration name="EgoBrakeDecel"   parameterType="double" value="{{ego_decel}}"/>
   </ParameterDeclarations>
   <CatalogLocations>
      <VehicleCatalog>
         <Directory path="{{assets}}/catalogs/Vehicles"/>
      </VehicleCatalog>
   </CatalogLocations>
   <RoadNetwork>
      <LogicFile filepath="{{assets}}/xodr/straight_500m.xodr"/>
      <SceneGraphFile filepath="straight_500m.osgb"/>
   </RoadNetwork>
   <Entities>
      <ScenarioObject name="Ego">
         <CatalogReference catalogName="VehicleCatalog" entryName="$EgoVehicle"/>
      </ScenarioObject>
      <ScenarioObject name="Lead">
         <CatalogReference catalogName="VehicleCatalog" entryName="$LeadVehicle"/>
      </ScenarioObject>
   </Entities>
   <Storyboard>
      <Init>
         <Actions>
{{environment_action}}
            <Private entityRef="Ego">
               <PrivateAction>
                  <TeleportAction>
                     <Position><LanePosition roadId="1" laneId="-1" offset="0" s="$EgoStartS"/></Position>
                  </TeleportAction>
               </PrivateAction>
               <PrivateAction>
                  <LongitudinalAction>
                     <SpeedAction>
                        <SpeedActionDynamics dynamicsShape="step" dynamicsDimension="time" value="0"/>
                        <SpeedActionTarget><AbsoluteTargetSpeed value="$EgoSpeed"/></SpeedActionTarget>
                     </SpeedAction>
                  </LongitudinalAction>
               </PrivateAction>
            </Private>
            <Private entityRef="Lead">
               <PrivateAction>
                  <TeleportAction>
                     <Position><LanePosition roadId="1" laneId="-1" offset="0" s="$LeadStartS"/></Position>
                  </TeleportAction>
               </PrivateAction>
               <PrivateAction>
                  <LongitudinalAction>
                     <SpeedAction>
                        <SpeedActionDynamics dynamicsShape="step" dynamicsDimension="time" value="0"/>
                        <SpeedActionTarget><AbsoluteTargetSpeed value="$LeadSpeed"/></SpeedActionTarget>
                     </SpeedAction>
                  </LongitudinalAction>
               </PrivateAction>
            </Private>
         </Actions>
      </Init>
      <Story name="RearEndStory">
         <Act name="RearEndAct">
            <ManeuverGroup maximumExecutionCount="1" name="LeadGroup">
               <Actors selectTriggeringEntities="false"><EntityRef entityRef="Lead"/></Actors>
               <Maneuver name="LeadManeuver">
                  <Event name="LeadBrakeEvent" priority="override" maximumExecutionCount="1">
                     <Action name="LeadBrakeAction">
                        <PrivateAction>
                           <LongitudinalAction>
                              <SpeedAction>
                                 <SpeedActionDynamics dynamicsShape="linear" dynamicsDimension="rate" value="$LeadDecel"/>
                                 <SpeedActionTarget><AbsoluteTargetSpeed value="$LeadFinalSpeed"/></SpeedActionTarget>
                              </SpeedAction>
                           </LongitudinalAction>
                        </PrivateAction>
                     </Action>
                     <StartTrigger>
                        <ConditionGroup>
                           <Condition name="LeadBrakeStart" delay="0" conditionEdge="rising">
                              <ByValueCondition>
                                 <SimulationTimeCondition value="$LeadBrakeTime" rule="greaterThan"/>
                              </ByValueCondition>
                           </Condition>
                        </ConditionGroup>
                     </StartTrigger>
                  </Event>
               </Maneuver>
            </ManeuverGroup>
{{ego_reaction_group}}
{{collision_group}}
            <StartTrigger>
               <ConditionGroup>
                  <Condition name="ActStart" delay="0" conditionEdge="none">
                     <ByValueCondition><SimulationTimeCondition value="0" rule="greaterThan"/></ByValueCondition>
                  </Condition>
               </ConditionGroup>
            </StartTrigger>
         </Act>
      </Story>
      <StopTrigger>
{{stop_conditions}}
      </StopTrigger>
   </Storyboard>
</OpenSCENARIO>
