<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by crash2sim from report {{report_id}} - template: ltap_od -->
<!-- Left Turn Across Path / Opposite Direction. Based on the esmini ltap-od example (MPL-2.0).   -->
<!-- A SynchronizeAction makes the turning vehicle (NPC) reach the conflict zone when Ego does.   -->
<OpenSCENARIO>
   <FileHeader revMajor="1" revMinor="2" date="{{date}}"
               description="crash2sim ltap_od from {{report_id}}" author="crash2sim"/>
   <ParameterDeclarations>
      <ParameterDeclaration name="EgoVehicle"       parameterType="string" value="{{ego_model}}"/>
      <ParameterDeclaration name="NPCVehicle"       parameterType="string" value="{{other_model}}"/>
      <ParameterDeclaration name="EgoSpeed"         parameterType="double" value="{{ego_speed}}"/>
      <ParameterDeclaration name="NPCInitialSpeed"  parameterType="double" value="{{npc_speed}}"/>
      <ParameterDeclaration name="NPCTurnSpeed"     parameterType="double" value="{{npc_final_speed}}"/>
      <ParameterDeclaration name="EgoStartPathS"    parameterType="double" value="{{ego_start_s}}"/>
      <ParameterDeclaration name="NPCStartPathS"    parameterType="double" value="{{npc_start_s}}"/>
      <ParameterDeclaration name="NPCSyncPathS"     parameterType="double" value="{{npc_sync_s}}"/>
      <ParameterDeclaration name="EgoSyncS"         parameterType="double" value="{{ego_sync_s}}"/>
      <ParameterDeclaration name="EgoReactionTime"  parameterType="double" value="{{reaction_time}}"/>
      <ParameterDeclaration name="EgoBrakeDecel"    parameterType="double" value="{{ego_decel}}"/>
      <ParameterDeclaration name="HazardDistance"   parameterType="double" value="{{hazard_distance}}"/>
   </ParameterDeclarations>
   <CatalogLocations>
      <RouteCatalog>
         <Directory path="{{assets}}/catalogs/Routes"/>
      </RouteCatalog>
      <VehicleCatalog>
         <Directory path="{{assets}}/catalogs/Vehicles"/>
      </VehicleCatalog>
   </CatalogLocations>
   <RoadNetwork>
      <LogicFile filepath="{{assets}}/xodr/fabriksgatan.xodr"/>
   </RoadNetwork>
   <Entities>
      <ScenarioObject name="Ego">
         <CatalogReference catalogName="VehicleCatalog" entryName="$EgoVehicle"/>
      </ScenarioObject>
      <ScenarioObject name="NPC">
         <CatalogReference catalogName="VehicleCatalog" entryName="$NPCVehicle"/>
      </ScenarioObject>
   </Entities>
   <Storyboard>
      <Init>
         <Actions>
{{environment_action}}
            <Private entityRef="Ego">
               <PrivateAction>
                  <RoutingAction>
                     <AssignRouteAction>
                        <CatalogReference catalogName="RoutesAtFabriksgatan" entryName="HostStraightRoute"/>
                     </AssignRouteAction>
                  </RoutingAction>
               </PrivateAction>
               <PrivateAction>
                  <TeleportAction>
                     <Position>
                        <RoutePosition>
                           <RouteRef>
                              <CatalogReference catalogName="RoutesAtFabriksgatan" entryName="HostStraightRoute"/>
                           </RouteRef>
                           <InRoutePosition><FromLaneCoordinates pathS="$EgoStartPathS" laneId="1"/></InRoutePosition>
                        </RoutePosition>
                     </Position>
                  </TeleportAction>
               </PrivateAction>
               <PrivateAction>
                  <LongitudinalAction>
                     <SpeedAction>
                        <SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/>
                        <SpeedActionTarget><AbsoluteTargetSpeed value="$EgoSpeed"/></SpeedActionTarget>
                     </SpeedAction>
                  </LongitudinalAction>
               </PrivateAction>
            </Private>
            <Private entityRef="NPC">
               <PrivateAction>
                  <RoutingAction>
                     <AssignRouteAction>
                        <CatalogReference catalogName="RoutesAtFabriksgatan" entryName="TargetLeftTurnRoute"/>
                     </AssignRouteAction>
                  </RoutingAction>
               </PrivateAction>
               <PrivateAction>
                  <TeleportAction>
                     <Position>
                        <RoutePosition>
                           <RouteRef>
                              <CatalogReference catalogName="RoutesAtFabriksgatan" entryName="TargetLeftTurnRoute"/>
                           </RouteRef>
                           <InRoutePosition><FromLaneCoordinates pathS="$NPCStartPathS" laneId="-1"/></InRoutePosition>
                        </RoutePosition>
                     </Position>
                  </TeleportAction>
               </PrivateAction>
               <PrivateAction>
                  <LongitudinalAction>
                     <SpeedAction>
                        <SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/>
                        <SpeedActionTarget><AbsoluteTargetSpeed value="$NPCInitialSpeed"/></SpeedActionTarget>
                     </SpeedAction>
                  </LongitudinalAction>
               </PrivateAction>
            </Private>
         </Actions>
      </Init>
      <Story name="LTAPStory">
         <Act name="LTAPAct">
            <ManeuverGroup maximumExecutionCount="1" name="NPCGroup">
               <Actors selectTriggeringEntities="false"><EntityRef entityRef="NPC"/></Actors>
               <Maneuver name="NPCManeuver">
                  <Event name="SyncEvent" priority="override" maximumExecutionCount="1">
                     <Action name="SyncAction">
                        <PrivateAction>
                           <SynchronizeAction masterEntityRef="Ego" targetToleranceMaster="1.0" targetTolerance="1.0">
                              <TargetPositionMaster>
                                 <LanePosition roadId="0" laneId="1" offset="0" s="$EgoSyncS"/>
                              </TargetPositionMaster>
                              <TargetPosition>
                                 <RoutePosition>
                                    <RouteRef>
                                       <CatalogReference catalogName="RoutesAtFabriksgatan" entryName="TargetLeftTurnRoute"/>
                                    </RouteRef>
                                    <InRoutePosition><FromLaneCoordinates pathS="$NPCSyncPathS" laneId="-1"/></InRoutePosition>
                                 </RoutePosition>
                              </TargetPosition>
                              <FinalSpeed><AbsoluteSpeed value="$NPCTurnSpeed"/></FinalSpeed>
                           </SynchronizeAction>
                        </PrivateAction>
                     </Action>
                     <StartTrigger>
                        <ConditionGroup>
                           <Condition name="SyncStart" delay="0" conditionEdge="none">
                              <ByValueCondition>
                                 <StoryboardElementStateCondition storyboardElementType="act"
                                    storyboardElementRef="LTAPAct" state="startTransition"/>
                              </ByValueCondition>
                           </Condition>
                        </ConditionGroup>
                     </StartTrigger>
                  </Event>
               </Maneuver>
            </ManeuverGroup>
{{ego_reaction_group}}
{{collision_group}}
            <StartTrigger>
               <ConditionGroup>
                  <Condition name="ActStart" delay="0" conditionEdge="none">
                     <ByValueCondition><SimulationTimeCondition value="0" rule="greaterThan"/></ByValueCondition>
                  </Condition>
               </ConditionGroup>
            </StartTrigger>
         </Act>
      </Story>
      <StopTrigger>
{{stop_conditions}}
      </StopTrigger>
   </Storyboard>
</OpenSCENARIO>
