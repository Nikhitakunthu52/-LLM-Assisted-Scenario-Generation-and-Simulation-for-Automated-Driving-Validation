<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by crash2sim from report {{report_id}} - template: head_on -->
<!-- Two-lane road. "Other" drifts over the center line into Ego's (oncoming) lane.          -->
<!-- Ego reacts after a reaction time; Other may brake shortly before impact (e.g. from EDR). -->
<OpenSCENARIO>
   <FileHeader revMajor="1" revMinor="2" date="{{date}}"
               description="crash2sim head_on from {{report_id}}" author="crash2sim"/>
   <ParameterDeclarations>
      <ParameterDeclaration name="EgoVehicle"        parameterType="string" value="{{ego_model}}"/>
      <ParameterDeclaration name="OtherVehicle"      parameterType="string" value="{{other_model}}"/>
      <ParameterDeclaration name="EgoStartS"         parameterType="double" value="{{ego_start_s}}"/>
      <ParameterDeclaration name="EgoSpeed"          parameterType="double" value="{{ego_speed}}"/>
      <ParameterDeclaration name="OtherSpeed"        parameterType="double" value="{{other_speed}}"/>
      <ParameterDeclaration name="OtherFinalSpeed"   parameterType="double" value="{{other_final_speed}}"/>
      <ParameterDeclaration name="OtherDecel"        parameterType="double" value="{{other_decel}}"/>
      <ParameterDeclaration name="OtherBrakeTTC"     parameterType="double" value="{{other_brake_ttc}}"/>
      <ParameterDeclaration name="DepartureDistance" parameterType="double" value="{{departure_distance}}"/>
      <ParameterDeclaration name="DepartureLatAcc"   parameterType="double" value="{{departure_lat_acc}}"/>
      <ParameterDeclaration name="DepartureOffset"   parameterType="double" value="{{departure_offset}}"/>
      <ParameterDeclaration name="EgoReactionTime"   parameterType="double" value="{{reaction_time}}"/>
      <ParameterDeclaration name="EgoBrakeDecel"     parameterType="double" value="{{ego_decel}}"/>
   </ParameterDeclarations>
   <CatalogLocations>
      <VehicleCatalog>
         <Directory path="{{assets}}/catalogs/Vehicles"/>
      </VehicleCatalog>
   </CatalogLocations>
   <RoadNetwork>
      <LogicFile filepath="{{assets}}/xodr/straight_500m.xodr"/>
      <SceneGraphFile filepath="straight_500m.osgb"/>
   </RoadNetwork>
   <Entities>
      <ScenarioObject name="Ego">
         <CatalogReference catalogName="VehicleCatalog" entryName="$EgoVehicle"/>
      </ScenarioObject>
      <ScenarioObject name="Other">
         <CatalogReference catalogName="VehicleCatalog" entryName="$OtherVehicle"/>
      </ScenarioObject>
   </Entities>
   <Storyboard>
      <Init>
         <Actions>
{{environment_action}}
            <Private entityRef="Ego">
               <PrivateAction>
                  <TeleportAction>
                     <Position><LanePosition roadId="1" laneId="1" offset="0" s="$EgoStartS"/></Position>
                  </TeleportAction>
               </PrivateAction>
               <PrivateAction>
                  <LongitudinalAction>
                     <SpeedAction>
                        <SpeedActionDynamics dynamicsShape="step" dynamicsDimension="time" value="0"/>
                        <SpeedActionTarget><AbsoluteTargetSpeed value="$EgoSpeed"/></SpeedActionTarget>
                     </SpeedAction>
                  </LongitudinalAction>
               </PrivateAction>
            </Private>
            <Private entityRef="Other">
               <PrivateAction>
                  <TeleportAction>
                     <Position><LanePosition roadId="1" laneId="-1" offset="0" s="20"/></Position>
                  </TeleportAction>
               </PrivateAction>
               <PrivateAction>
                  <LongitudinalAction>
                     <SpeedAction>
                        <SpeedActionDynamics dynamicsShape="step" dynamicsDimension="time" value="0"/>
                        <SpeedActionTarget><AbsoluteTargetSpeed value="$OtherSpeed"/></SpeedActionTarget>
                     </SpeedAction>
                  </LongitudinalAction>
               </PrivateAction>
            </Private>
         </Actions>
      </Init>
      <Story name="HeadOnStory">
         <Act name="HeadOnAct">
            <ManeuverGroup maximumExecutionCount="1" name="OtherGroup">
               <Actors selectTriggeringEntities="false"><EntityRef entityRef="Other"/></Actors>
               <Maneuver name="OtherManeuver">
                  <Event name="LaneDepartureEvent" priority="parallel" maximumExecutionCount="1">
                     <Action name="DriftLeft">
                        <PrivateAction>
                           <LateralAction>
                              <LaneOffsetAction continuous="false">
                                 <LaneOffsetActionDynamics maxLateralAcc="$DepartureLatAcc" dynamicsShape="sinusoidal"/>
                                 <LaneOffsetTarget><AbsoluteTargetLaneOffset value="$DepartureOffset"/></LaneOffsetTarget>
                              </LaneOffsetAction>
                           </LateralAction>
                        </PrivateAction>
                     </Action>
                     <StartTrigger>
                        <ConditionGroup>
                           <Condition name="DepartureStart" delay="0" conditionEdge="rising">
                              <ByEntityCondition>
                                 <TriggeringEntities triggeringEntitiesRule="any"><EntityRef entityRef="Other"/></TriggeringEntities>
                                 <EntityCondition>
                                    <RelativeDistanceCondition entityRef="Ego" freespace="true" relativeDistanceType="euclidianDistance" rule="lessThan" value="$DepartureDistance"/>
                                 </EntityCondition>
                              </ByEntityCondition>
                           </Condition>
                        </ConditionGroup>
                     </StartTrigger>
                  </Event>
{{other_brake_event}}
               </Maneuver>
            </ManeuverGroup>
{{ego_reaction_group}}
{{collision_group}}
            <StartTrigger>
               <ConditionGroup>
                  <Condition name="ActStart" delay="0" conditionEdge="none">
                     <ByValueCondition><SimulationTimeCondition value="0" rule="greaterThan"/></ByValueCondition>
                  </Condition>
               </ConditionGroup>
            </StartTrigger>
         </Act>
      </Story>
      <StopTrigger>
{{stop_conditions}}
      </StopTrigger>
   </Storyboard>
</OpenSCENARIO>
